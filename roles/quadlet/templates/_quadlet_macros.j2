{#-
  Jinja2 helper macros for rendering Podman Quadlet unit files (systemd unit
  syntax, see "man podman-systemd.unit") from a per-unit "sections" dictionary.

  Rendering rules:
  - Sections appear in canonical order (Unit, the type-specific section,
    Service, Install); any further section follows in the supplied order.
  - Scalar values become single "Key=value" lines.
  - List values become repeated "Key=value" lines (Quadlet/systemd allow
    repeating settings like Volume=, PublishPort= or Environment=).
  - Boolean values are rendered as true/false.
  - Values of the assignment-list settings Environment=, Label= and
    Annotation= are quoted for systemd when they contain whitespace, quotes
    or backslashes: their grammar is a space-separated list, so an unquoted
    "A=x y" would be split into the assignment "A=x" plus a stray word "y"
    (silently truncating e.g. an ES_JAVA_OPTS value). One item therefore
    always stays exactly one assignment. Deliberately NOT applied to
    command-line settings like Exec= or PodmanArgs=, where word splitting
    is the intended grammar.
  - In the [Unit] dependency settings (After=, Requires=, ...), the Unit=
    setting of [Timer] and [Path] sections and the Service= setting of
    [Socket] sections, values without a dot that match the name of another
    unit of the application get expanded to that unit's generated service
    name (via the passed service map).

  The macros render plain systemd units (e.g. .timer files of
  quadlet_podman_systemd_units) just as well: only the canonical section
  order and the Quadlet-specific type section differ per caller.
-#}

{%- set quadlet_assignment_list_keys = ['Environment', 'Label', 'Annotation'] -%}

{%- macro render_quadlet_assignment(value) -%}
{%-   set v = value | ansible.builtin.string | ansible.builtin.trim -%}
{%-   if (' ' in v) or ('\t' in v) or ('"' in v) or ('\\' in v) -%}
"{{ v | ansible.builtin.replace('\\', '\\\\') | ansible.builtin.replace('"', '\\"') }}"
{%-   else -%}
{{ v }}
{%-   endif -%}
{%- endmacro -%}


{%- macro render_quadlet_line(key, value) -%}
{%-   if value is ansible.builtin.boolean -%}
{{ key }}={{ value | ansible.builtin.ternary('true', 'false') }}
{%-   elif key in quadlet_assignment_list_keys -%}
{{ key }}={{ render_quadlet_assignment(value) }}
{%-   else -%}
{{ key }}={{ value | ansible.builtin.string | ansible.builtin.trim }}
{%-   endif -%}
{%- endmacro -%}


{%- macro render_quadlet_dependency_value(value, service_map) -%}
{%-   if ('.' not in (value | ansible.builtin.string)) and ((value | ansible.builtin.string) in service_map) -%}
{{ service_map[value | ansible.builtin.string] }}
{%-   else -%}
{{ value | ansible.builtin.string | ansible.builtin.trim }}
{%-   endif -%}
{%- endmacro -%}


{%- macro render_quadlet_section(name, settings, service_map, dependency_keys) %}
[{{ name }}]
{%    for key, value in settings.items() %}
{%      set is_dependency = ((name == 'Unit') and (key in dependency_keys))
                            or ((name in ['Timer', 'Path']) and (key == 'Unit'))
                            or ((name == 'Socket') and (key == 'Service')) %}
{%      if value is ansible.builtin.sequence and value is not ansible.builtin.string %}
{%        for item in value %}
{%          if is_dependency %}
{{ key }}={{ render_quadlet_dependency_value(item, service_map) }}
{%          else %}
{{ render_quadlet_line(key, item) }}
{%          endif %}
{%        endfor %}
{%      elif is_dependency %}
{{ key }}={{ render_quadlet_dependency_value(value, service_map) }}
{%      else %}
{{ render_quadlet_line(key, value) }}
{%      endif %}
{%    endfor %}
{%- endmacro -%}


{%- macro render_quadlet_unit(sections, type_section, service_map, dependency_keys) -%}
{#-   unique: for plain units the type section may itself be Unit or Service -#}
{%-   set canonical_order = ['Unit', type_section, 'Service', 'Install'] | ansible.builtin.unique | ansible.builtin.list -%}
{%-   for name in canonical_order if name in sections %}
{{ render_quadlet_section(name, sections[name], service_map, dependency_keys) }}
{%-   endfor -%}
{%-   for name, settings in sections.items() if name not in canonical_order %}
{{ render_quadlet_section(name, settings, service_map, dependency_keys) }}
{%-   endfor -%}
{%- endmacro -%}
