{%- from '_quadlet_macros.j2' import render_quadlet_unit -%}
{#-
  Podman Quadlet unit file (see "man podman-systemd.unit"), rendered from one
  effective entry of quadlet_podman_units.

  Input variables:
  - tpl_unit: effective unit dict (name, type, sections, ...)
  - tpl_service_map: unit name -> generated systemd service name
  - tpl_file_marker: application ownership marker (first line, load-bearing
    for the cleanup logic - do not change its format)
-#}
{{ tpl_file_marker }}
# {{ ansible_managed }}
{{ render_quadlet_unit(
     tpl_unit['sections'],
     __quadlet_podman_type_section_map[tpl_unit['type']],
     tpl_service_map,
     __quadlet_podman_dependency_keys
   ) }}
